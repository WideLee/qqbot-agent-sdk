# Local environment overrides for examples/e2e_test.py.
# Copy to ".env" and fill in your own values. The .env file is gitignored.

# ── Speech-to-Text (STT) — used by the voice attachment pipeline ──────
# Option A: reuse an OpenAI API key — automatically configures Whisper.
# OPENAI_API_KEY=sk-...

# Option B: explicit STT settings (highest priority, also recognized by
# qqbot_agent_sdk.audio.resolve_stt_config()):
# QQ_STT_API_KEY=...
# QQ_STT_BASE_URL=https://api.openai.com/v1
# QQ_STT_MODEL=whisper-1
